# ==============================================================================
# PeerLume Environment Configuration (.env.example)
# Copy this file to .env before starting the services:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://peerlume_user:peerlume_pass@localhost:5432/peerlume_db?schema=public

# Authentication & Session Security (Replace in production with 32+ char random strings)
JWT_ACCESS_SECRET=peerlume_dev_jwt_access_secret_super_secure_32chars!
JWT_REFRESH_SECRET=peerlume_dev_jwt_refresh_secret_super_secure_32chars!
COOKIE_SECRET=peerlume_dev_cookie_signing_secret_super_secure!

# Email Service Configuration ('development' or 'smtp')
# In 'development' mode, verification & reset links are logged to console safely without sending real emails.
EMAIL_PROVIDER=development
EMAIL_FROM="PeerLume <noreply@peerlume.local>"
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# ------------------------------------------------------------------------------
# WebRTC Audio & Video Calling (STUN/TURN)
# ------------------------------------------------------------------------------
# Public STUN servers are used by default for NAT traversal.
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# For restrictive enterprise/symmetric NAT networks in production, configure a TURN server:
# TURN_SERVER="turn:turn.yourdomain.com:3478"
# TURN_USERNAME="peerlume_turn_user"
# TURN_CREDENTIAL="peerlume_turn_password_secret"

# ------------------------------------------------------------------------------
# Knowledge-Sharing Workspace & Reminders (Phase 5)
# ------------------------------------------------------------------------------
# Storage directory for shared workspace files (defaults to apps/api/uploads)
# UPLOAD_DIR=./uploads
# Maximum upload size in bytes (defaults to 15728640 = 15MB)
# MAX_FILE_SIZE_BYTES=15728640

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
# Base URL for the backend API, accessed by the browser
VITE_API_BASE_URL=http://localhost:5000/api

