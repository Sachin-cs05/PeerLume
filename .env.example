# ==============================================================================
# PeerLume Environment Configuration (.env.example)
#
# Quick setup:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
#   The secrets below are safe defaults for local development only.
#   In production (NODE_ENV=production), the application will refuse to start
#   with default dev secrets. Generate strong 32+ byte hex secrets:
#     openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Configuration (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Local Docker/Postgres: postgresql://postgres:postgres@localhost:5432/peerlume?schema=public
# Cloud (Neon / Supabase): postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=postgresql://peerlume_user:peerlume_pass@localhost:5432/peerlume_db?schema=public

# Authentication & Session Security (Must be 32+ chars; generate via: openssl rand -hex 32)
JWT_ACCESS_SECRET=peerlume_dev_jwt_access_secret_super_secure_32chars!
JWT_REFRESH_SECRET=peerlume_dev_jwt_refresh_secret_super_secure_32chars!
COOKIE_SECRET=peerlume_dev_cookie_signing_secret_super_secure!

# Email Service Configuration ('development' or 'smtp')
# In 'development', verification & reset links log safely to the console.
EMAIL_PROVIDER=development
EMAIL_FROM="PeerLume <noreply@peerlume.local>"
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# ------------------------------------------------------------------------------
# WebRTC Audio & Video Calling (STUN/TURN)
# ------------------------------------------------------------------------------
# Public Google STUN servers for NAT traversal (default)
STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# Optional TURN server for restrictive firewall/symmetric NAT networks:
# TURN_SERVER="turn:turn.yourdomain.com:3478"
# TURN_USERNAME="peerlume_turn_user"
# TURN_CREDENTIAL="peerlume_turn_password_secret"

# ------------------------------------------------------------------------------
# Frontend Web Configuration (apps/web)
# ------------------------------------------------------------------------------
# Base URL for the backend API, accessed by the browser
VITE_API_BASE_URL=http://localhost:5000/api
