// PeerLume Prisma Schema - Phase 3: Friends, Connections & Smart Learning Partner Matching
// "Learn Together. Grow Together."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Core User Model
// Note: PeerLume has NO Admin role or Admin dashboard; all users are peer students.
// -----------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  avatarUrl       String?  @map("avatar_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile                  StudentProfile?
  refreshSessions          RefreshSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  // Phase 3: Friends, Requests, Blocks, and Saved Partners
  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsAsUser1     Friendship[]    @relation("Friendships1")
  friendshipsAsUser2     Friendship[]    @relation("Friendships2")
  blocksInitiated        UserBlock[]     @relation("BlocksInitiated")
  blocksReceived         UserBlock[]     @relation("BlocksReceived")
  savedPartners          SavedPartner[]  @relation("SavedPartnersOwner")
  savedByStudents        SavedPartner[]  @relation("SavedPartnersTarget")

  @@map("users")
}

// -----------------------------------------------------------------------------
// Student Profile & Academic Details
// -----------------------------------------------------------------------------

enum PreferredLearningMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum ProfileVisibility {
  PUBLIC
  CAMPUS_ONLY
  CONNECTIONS_ONLY
}

model StudentProfile {
  id                    String                @id @default(uuid())
  userId                String                @unique @map("user_id")
  college               String
  degree                String
  branch                String
  semester              String
  bio                   String?               @db.Text
  languages             String[]              @default(["English"])
  preferredLearningMode PreferredLearningMode @default(HYBRID) @map("preferred_learning_mode")
  visibility            ProfileVisibility     @default(PUBLIC)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingSkills UserTeachingSkill[]
  learningGoals  UserLearningGoal[]

  @@map("student_profiles")
}

// -----------------------------------------------------------------------------
// Normalized Skills & Goal Tracking
// -----------------------------------------------------------------------------

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?  @default("General")
  createdAt DateTime @default(now()) @map("created_at")

  teachingUsers UserTeachingSkill[]
  learningUsers UserLearningGoal[]

  @@map("skills")
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model UserTeachingSkill {
  id          String           @id @default(uuid())
  profileId   String           @map("profile_id")
  skillId     String           @map("skill_id")
  proficiency SkillProficiency @default(INTERMEDIATE)
  createdAt   DateTime         @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("user_teaching_skills")
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

model UserLearningGoal {
  id                String       @id @default(uuid())
  profileId         String       @map("profile_id")
  skillId           String       @map("skill_id")
  targetDescription String?      @map("target_description")
  priority          GoalPriority @default(MEDIUM)
  createdAt         DateTime     @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("user_learning_goals")
}

// -----------------------------------------------------------------------------
// Authentication Tokens & Sessions
// -----------------------------------------------------------------------------

model RefreshSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  hashedToken String   @unique @map("hashed_token")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Phase 3: Friends, Connections & Blocking Models
// -----------------------------------------------------------------------------

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String              @map("sender_id")
  receiverId String              @map("receiver_id")
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String   @map("user1_id")
  user2Id   String   @map("user2_id")
  createdAt DateTime @default(now()) @map("created_at")

  user1 User @relation("Friendships1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("Friendships2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("friendships")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model SavedPartner {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  savedStudentId String   @map("saved_student_id")
  notes          String?  @map("notes")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User @relation("SavedPartnersOwner", fields: [userId], references: [id], onDelete: Cascade)
  savedStudent User @relation("SavedPartnersTarget", fields: [savedStudentId], references: [id], onDelete: Cascade)

  @@unique([userId, savedStudentId])
  @@index([userId])
  @@index([savedStudentId])
  @@map("saved_partners")
}
