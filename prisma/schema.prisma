// PeerLume Prisma Schema - Phase 3: Friends, Connections & Smart Learning Partner Matching
// "Learn Together. Grow Together."

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Core User Model
// Note: PeerLume has NO Admin role or Admin dashboard; all users are peer students.
// -----------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  avatarUrl       String?  @map("avatar_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  profile                  StudentProfile?
  refreshSessions          RefreshSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]

  // Phase 3: Friends, Requests, Blocks, and Saved Partners
  sentFriendRequests     FriendRequest[] @relation("SentRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsAsUser1     Friendship[]    @relation("Friendships1")
  friendshipsAsUser2     Friendship[]    @relation("Friendships2")
  blocksInitiated        UserBlock[]     @relation("BlocksInitiated")
  blocksReceived         UserBlock[]     @relation("BlocksReceived")
  savedPartners          SavedPartner[]  @relation("SavedPartnersOwner")
  savedByStudents        SavedPartner[]  @relation("SavedPartnersTarget")

  // Phase 4: Chat Conversations, Messages, Calls & Notifications
  conversationsAsUser1   Conversation[]  @relation("Conversations1")
  conversationsAsUser2   Conversation[]  @relation("Conversations2")
  sentMessages           Message[]       @relation("SentMessages")
  initiatedCalls         CallSession[]   @relation("InitiatedCalls")
  receivedCalls          CallSession[]   @relation("ReceivedCalls")
  notificationsReceived  Notification[]  @relation("NotificationsReceived")
  notificationsTriggered Notification[]  @relation("NotificationsTriggered")

  // Phase 5: Sessions, Resources, Notes & Reminders
  organizedSessions     LearningSession[]     @relation("OrganizedSessions")
  sessionParticipations SessionParticipant[]  @relation("SessionParticipations")
  rescheduleProposals   RescheduleProposal[]  @relation("RescheduleProposals")
  createdResources      LearningResource[]    @relation("CreatedResources")
  receivedResources     LearningResource[]    @relation("ReceivedResources")
  sessionReminders      SessionReminder[]     @relation("SessionReminders")

  // Phase 6: Collaborative Code Workspaces
  createdCodeWorkspaces        CodeWorkspace[]            @relation("CreatedCodeWorkspaces")
  codeWorkspaceParticipations CodeWorkspaceParticipant[] @relation("CodeWorkspaceParticipants")
  createdDocumentRevisions     DocumentRevision[]         @relation("DocumentRevisionsCreated")

  // Phase 7: Interactive Study Rooms, Whiteboards & Preferences
  createdStudyRooms            StudyRoom[]                @relation("CreatedStudyRooms")
  studyRoomParticipants        StudyRoomParticipant[]     @relation("StudyRoomParticipants")
  createdWhiteboardRevisions   WhiteboardRevision[]       @relation("WhiteboardRevisionsCreated")
  preferences                  UserPreference?

  @@map("users")
}

// -----------------------------------------------------------------------------
// Student Profile & Academic Details
// -----------------------------------------------------------------------------

enum PreferredLearningMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum ProfileVisibility {
  PUBLIC
  CAMPUS_ONLY
  CONNECTIONS_ONLY
}

model StudentProfile {
  id                    String                @id @default(uuid())
  userId                String                @unique @map("user_id")
  college               String
  degree                String
  branch                String
  semester              String
  bio                   String?               @db.Text
  languages             String[]              @default(["English"])
  preferredLearningMode PreferredLearningMode @default(HYBRID) @map("preferred_learning_mode")
  visibility            ProfileVisibility     @default(PUBLIC)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingSkills UserTeachingSkill[]
  learningGoals  UserLearningGoal[]

  @@map("student_profiles")
}

// -----------------------------------------------------------------------------
// Normalized Skills & Goal Tracking
// -----------------------------------------------------------------------------

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String?  @default("General")
  createdAt DateTime @default(now()) @map("created_at")

  teachingUsers UserTeachingSkill[]
  learningUsers UserLearningGoal[]

  @@map("skills")
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model UserTeachingSkill {
  id          String           @id @default(uuid())
  profileId   String           @map("profile_id")
  skillId     String           @map("skill_id")
  proficiency SkillProficiency @default(INTERMEDIATE)
  createdAt   DateTime         @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("user_teaching_skills")
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

model UserLearningGoal {
  id                String       @id @default(uuid())
  profileId         String       @map("profile_id")
  skillId           String       @map("skill_id")
  targetDescription String?      @map("target_description")
  priority          GoalPriority @default(MEDIUM)
  createdAt         DateTime     @default(now()) @map("created_at")

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@map("user_learning_goals")
}

// -----------------------------------------------------------------------------
// Authentication Tokens & Sessions
// -----------------------------------------------------------------------------

model RefreshSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  hashedToken String   @unique @map("hashed_token")
  userAgent   String?  @map("user_agent")
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Phase 3: Friends, Connections & Blocking Models
// -----------------------------------------------------------------------------

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String              @map("sender_id")
  receiverId String              @map("receiver_id")
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("friend_requests")
}

model Friendship {
  id        String   @id @default(uuid())
  user1Id   String   @map("user1_id")
  user2Id   String   @map("user2_id")
  createdAt DateTime @default(now()) @map("created_at")

  user1 User @relation("Friendships1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("Friendships2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("friendships")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model SavedPartner {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  savedStudentId String   @map("saved_student_id")
  notes          String?  @map("notes")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User @relation("SavedPartnersOwner", fields: [userId], references: [id], onDelete: Cascade)
  savedStudent User @relation("SavedPartnersTarget", fields: [savedStudentId], references: [id], onDelete: Cascade)

  @@unique([userId, savedStudentId])
  @@index([userId])
  @@index([savedStudentId])
  @@map("saved_partners")
}

// -----------------------------------------------------------------------------
// Phase 4: Real-Time Messaging, Calls & Persistent Notifications
// -----------------------------------------------------------------------------

enum MessageType {
  TEXT
  CODE
  LINK
  RESOURCE
  FILE
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

enum NotificationType {
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  NEW_MESSAGE
  CALL_INCOMING
  CALL_MISSED
  SESSION_INVITATION_RECEIVED
  SESSION_INVITATION_ACCEPTED
  SESSION_INVITATION_DECLINED
  SESSION_RESCHEDULE_PROPOSED
  SESSION_RESCHEDULE_RESOLVED
  SESSION_CANCELLED
  SESSION_REMINDER
}

model Conversation {
  id            String    @id @default(uuid())
  user1Id       String    @map("user1_id")
  user2Id       String    @map("user2_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user1    User      @relation("Conversations1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("Conversations2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  type           MessageType @default(TEXT)
  content        String      @db.Text
  metadata       Json?       @map("metadata")
  isRead         Boolean     @default(false) @map("is_read")
  readAt         DateTime?   @map("read_at")
  clientTempId   String?     @map("client_temp_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, isRead])
  @@map("messages")
}

model CallSession {
  id         String     @id @default(uuid())
  callerId   String     @map("caller_id")
  receiverId String     @map("receiver_id")
  type       CallType   @default(VIDEO)
  status     CallStatus @default(INITIATED)
  startedAt  DateTime?  @map("started_at")
  endedAt    DateTime?  @map("ended_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  caller   User @relation("InitiatedCalls", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedCalls", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([receiverId])
  @@index([status])
  @@map("call_sessions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  actorId   String?          @map("actor_id")
  type      NotificationType
  title     String
  body      String
  data      Json?            @map("data")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User  @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationsTriggered", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// -----------------------------------------------------------------------------
// Phase 5: Sessions, Calendars, Resources & Reminders
// -----------------------------------------------------------------------------

enum SessionMode {
  ONLINE
  IN_PERSON
}

enum SessionStatus {
  PENDING
  ACCEPTED
  DECLINED
  RESCHEDULE_REQUESTED
  CANCELLED
  COMPLETED
}

enum ParticipantRole {
  ORGANIZER
  INVITEE
}

enum ParticipantStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ResourceType {
  NOTE
  LINK
  CODE
  DOCUMENT
}

model LearningSession {
  id           String        @id @default(uuid())
  organizerId  String        @map("organizer_id")
  title        String
  topic        String
  description  String?       @db.Text
  objectives   String?       @db.Text
  startTime    DateTime      @map("start_time") // UTC
  endTime      DateTime      @map("end_time")   // UTC
  timeZone     String        @default("UTC") @map("time_zone")
  mode         SessionMode   @default(ONLINE)
  location     String?       @map("location")
  meetingUrl   String?       @map("meeting_url")
  status       SessionStatus @default(PENDING)
  cancelReason String?       @map("cancel_reason")
  notes        String?       @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  organizer           User                 @relation("OrganizedSessions", fields: [organizerId], references: [id], onDelete: Cascade)
  participants        SessionParticipant[]
  rescheduleProposals RescheduleProposal[]
  resources           LearningResource[]
  reminders           SessionReminder[]
  codeWorkspaces      CodeWorkspace[]      @relation("SessionWorkspaces")
  studyRooms          StudyRoom[]          @relation("SessionStudyRooms")

  @@index([organizerId])
  @@index([startTime, endTime])
  @@index([status])
  @@map("learning_sessions")
}

model SessionParticipant {
  id             String            @id @default(uuid())
  sessionId      String            @map("session_id")
  userId         String            @map("user_id")
  role           ParticipantRole   @default(INVITEE)
  status         ParticipantStatus @default(PENDING)
  declinedReason String?           @map("declined_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation("SessionParticipations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId, status])
  @@index([sessionId])
  @@map("session_participants")
}

model RescheduleProposal {
  id                String           @id @default(uuid())
  sessionId         String           @map("session_id")
  proposerId        String           @map("proposer_id")
  proposedStartTime DateTime         @map("proposed_start_time")
  proposedEndTime   DateTime         @map("proposed_end_time")
  proposedTimeZone  String           @map("proposed_time_zone")
  reason            String?          @map("reason")
  status            RescheduleStatus @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  session  LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  proposer User            @relation("RescheduleProposals", fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("reschedule_proposals")
}

model LearningResource {
  id           String       @id @default(uuid())
  creatorId    String       @map("creator_id")
  sessionId    String?      @map("session_id")
  targetUserId String?      @map("target_user_id")
  type         ResourceType @default(NOTE)
  title        String
  description  String?      @db.Text
  content      String?      @db.Text
  url          String?
  language     String?
  fileKey      String?      @map("file_key")
  fileName     String?      @map("file_name")
  fileSize     Int?         @map("file_size")
  mimeType     String?      @map("mime_type")
  isPrivate    Boolean      @default(false) @map("is_private")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  creator    User             @relation("CreatedResources", fields: [creatorId], references: [id], onDelete: Cascade)
  session    LearningSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetUser User?            @relation("ReceivedResources", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([sessionId])
  @@index([targetUserId])
  @@map("learning_resources")
}

model SessionReminder {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  userId        String   @map("user_id")
  minutesBefore Int      @map("minutes_before")
  sentAt        DateTime @default(now()) @map("sent_at")

  session LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation("SessionReminders", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, minutesBefore])
  @@index([userId])
  @@index([sessionId])
  @@map("session_reminders")
}

// -----------------------------------------------------------------------------
// Phase 6: Real-Time Collaborative Code Editor Models
// -----------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model CodeWorkspace {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  sessionId   String?  @map("session_id")
  creatorId   String   @map("creator_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator      User                       @relation("CreatedCodeWorkspaces", fields: [creatorId], references: [id], onDelete: Cascade)
  session      LearningSession?           @relation("SessionWorkspaces", fields: [sessionId], references: [id], onDelete: SetNull)
  participants CodeWorkspaceParticipant[]
  documents    CodeDocument[]
  revisions    DocumentRevision[]

  @@index([creatorId])
  @@index([sessionId])
  @@map("code_workspaces")
}

model CodeWorkspaceParticipant {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(EDITOR)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace CodeWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation("CodeWorkspaceParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("code_workspace_participants")
}

model CodeDocument {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  title       String
  language    String   @default("typescript")
  content     String   @default("") @db.Text
  yjsState    Bytes?   @map("yjs_state")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace CodeWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  revisions DocumentRevision[]

  @@index([workspaceId])
  @@map("code_documents")
}

model DocumentRevision {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  documentId  String   @map("document_id")
  content     String   @db.Text
  language    String
  description String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace CodeWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  CodeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User          @relation("DocumentRevisionsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([workspaceId])
  @@map("document_revisions")
}

// -----------------------------------------------------------------------------
// Phase 7: Interactive Study Rooms, Whiteboards & Preferences
// -----------------------------------------------------------------------------

enum StudyRoomRole {
  OWNER
  EDITOR
  VIEWER
}

model StudyRoom {
  id          String   @id @default(uuid())
  title       String
  topic       String
  description String?  @db.Text
  sessionId   String?  @map("session_id")
  creatorId   String   @map("creator_id")
  isActive    Boolean  @default(true) @map("is_active")
  endedAt     DateTime? @map("ended_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator      User                   @relation("CreatedStudyRooms", fields: [creatorId], references: [id], onDelete: Cascade)
  session      LearningSession?       @relation("SessionStudyRooms", fields: [sessionId], references: [id], onDelete: SetNull)
  participants StudyRoomParticipant[]
  whiteboards  WhiteboardDocument[]

  @@index([creatorId])
  @@index([sessionId])
  @@index([isActive])
  @@map("study_rooms")
}

model StudyRoomParticipant {
  id       String        @id @default(uuid())
  roomId   String        @map("room_id")
  userId   String        @map("user_id")
  role     StudyRoomRole @default(EDITOR)
  joinedAt DateTime      @default(now()) @map("joined_at")
  leftAt   DateTime?     @map("left_at")

  room StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User      @relation("StudyRoomParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
  @@map("study_room_participants")
}

model WhiteboardDocument {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  title     String   @default("Main Board")
  elements  Json     @default("[]")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room      StudyRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  revisions WhiteboardRevision[]

  @@index([roomId])
  @@map("whiteboard_documents")
}

model WhiteboardRevision {
  id          String   @id @default(uuid())
  boardId     String   @map("board_id")
  elements    Json
  description String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  board     WhiteboardDocument @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User               @relation("WhiteboardRevisionsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([boardId, createdAt])
  @@map("whiteboard_revisions")
}

model UserPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  theme              String   @default("system") // "light", "dark", "system"
  emailNotifications Boolean  @default(true) @map("email_notifications")
  soundEnabled       Boolean  @default(true) @map("sound_enabled")
  reducedMotion      Boolean  @default(false) @map("reduced_motion")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}



